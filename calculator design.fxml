<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="400.0"
      prefWidth="330.0"
      spacing="5.0"
      xmlns="http://javafx.com/javafx/23.0.8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="CalculatorController.CalculatorController">

    <padding>
        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
    </padding>

    <children>

        <!-- DISPLAY -->
        <TextField fx:id="display"
                   editable="false"
                   prefHeight="80.0"
                   prefWidth="310.0"/>

        <!-- BARIS 1 -->
        <HBox spacing="5.0">
            <children>

                <Button text="&lt;x"
                        prefWidth="70.0"
                        prefHeight="50.0"/>

                <Button text="AC"
                        onAction="#handleClear"
                        prefWidth="70.0"
                        prefHeight="50.0"/>

                <Button text=":"
                        prefWidth="70.0"
                        prefHeight="50.0"/>

                <Button text="/"
                        onAction="#handleOperator"
                        prefWidth="70.0"
                        prefHeight="50.0"/>

            </children>
        </HBox>

        <!-- BARIS 2 -->
        <HBox spacing="5.0">
            <children>

                <Button text="7"
                        onAction="#handleNumber"
                        prefWidth="70.0"
                        prefHeight="50.0"/>

                <Button text="8"
                        onAction="#handleNumber"
                        prefWidth="70.0"
                        prefHeight="50.0"/>

                <Button text="9"
                        onAction="#handleNumber"
                        prefWidth="70.0"
                        prefHeight="50.0"/>

                <Button text="*"
                        onAction="#handleOperator"
                        prefWidth="70.0"
                        prefHeight="50.0"/>

            </children>
        </HBox>

        <!-- BARIS 3 -->
        <HBox spacing="5.0">
            <children>

                <Button text="4"
                        onAction="#handleNumber"
                        prefWidth="70.0"
                        prefHeight="50.0"/>

                <Button text="5"
                        onAction="#handleNumber"
                        prefWidth="70.0"
                        prefHeight="50.0"/>

                <Button text="6"
                        onAction="#handleNumber"
                        prefWidth="70.0"
                        prefHeight="50.0"/>

                <Button text="+"
                        onAction="#handleOperator"
                        prefWidth="70.0"
                        prefHeight="50.0"/>

            </children>
        </HBox>

        <!-- BARIS 4 -->
        <HBox spacing="5.0">
            <children>

                <Button text="1"
                        onAction="#handleNumber"
                        prefWidth="70.0"
                        prefHeight="50.0"/>

                <Button text="2"
                        onAction="#handleNumber"
                        prefWidth="70.0"
                        prefHeight="50.0"/>

                <Button text="3"
                        onAction="#handleNumber"
                        prefWidth="70.0"
                        prefHeight="50.0"/>

                <Button text="-"
                        onAction="#handleOperator"
                        prefWidth="70.0"
                        prefHeight="50.0"/>

            </children>
        </HBox>

        <!-- BARIS 5 -->
        <HBox spacing="5.0">
            <children>

                <Button text="+/-"
                        prefWidth="70.0"
                        prefHeight="50.0"/>

                <Button text="0"
                        onAction="#handleNumber"
                        prefWidth="70.0"
                        prefHeight="50.0"/>

                <Button text="."
                        onAction="#handleNumber"
                        prefWidth="70.0"
                        prefHeight="50.0"/>

                <Button text="="
                        onAction="#handleEqual"
                        prefWidth="70.0"
                        prefHeight="50.0"/>

            </children>
        </HBox>

    </children>

</VBox>